<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ducky" parent="android:Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/sky</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Shared button base -->
    <style name="Widget.Ducky.Button" parent="android:Widget.DeviceDefault.Button">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <!-- Main call-to-action: yellow/orange 3D key -->
    <style name="Widget.Ducky.Button.Primary">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/btn_primary_text</item>
        <item name="android:drawableTint">@color/btn_primary_text</item>
    </style>

    <!-- Secondary action: translucent glass -->
    <style name="Widget.Ducky.Button.Secondary">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:drawableTint">@color/white</item>
        <item name="android:paddingBottom">0dp</item>
    </style>

    <!-- Small caps label used above values -->
    <style name="TextAppearance.Ducky.Label" parent="android:TextAppearance.DeviceDefault">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">0.14</item>
    </style>
</resources>